$(eval $(call import.MODULE.defs,FRIBIDI,fribidi))
$(eval $(call import.CONTRIB.defs,FRIBIDI))

FRIBIDI.FETCH.url      = https://github.com/HandBrake/HandBrake-contribs/releases/download/contribs2/fribidi-1.0.17.tar.gz
FRIBIDI.FETCH.url     += https://github.com/fribidi/fribidi/archive/v1.0.17.tar.gz
FRIBIDI.FETCH.sha256   = ab015bb040b2ff4bf815813c21948947dad1e0186473359e99a8881c79878d5d
FRIBIDI.FETCH.basename = fribidi-1.0.17.tar.gz

FRIBIDI.CONFIGURE.bootstrap = rm -fr aclocal.m4 autom4te.cache configure; autoreconf -I m4 -fiv;

FRIBIDI.GCC.args.extra += $(FRIBIDI.GCC.args.O.$(FRIBIDI.GCC.O))

ifeq ($(HOST.system),darwin)
    FRIBIDI.CONFIGURE.extra = CFLAGS_FOR_BUILD="-arch $(BUILD.machine)"
endif

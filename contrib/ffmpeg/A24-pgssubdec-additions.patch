+
+                for (y = 0; y < sub_object->crop_h; y++) {
+                    memcpy(&rect->data[0][y * sub_object->crop_w],
+                           &object->bitmap[(sub_object->crop_y + y) *
+                           object->w + sub_object->crop_x],
+                           sub_object->crop_w);
+                }
+            }
+            else {
+                /* copy full object */
+                memcpy(rect->data[0], object->bitmap, rect->w * rect->h);
+            }
         }
     }
     return 1;
-- 

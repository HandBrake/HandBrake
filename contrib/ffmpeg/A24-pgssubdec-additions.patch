@@ -260,7 +271,62 @@ static int parse_object_segment(AVCodecContext *avctx,
     /* Read the Sequence Description to determine if start of RLE data or appended to previous RLE */
     sequence_desc = bytestream_get_byte(&buf);
 
-    if (!(sequence_desc & 0x80)) {
+    /* First in sequence object definition segment */
+    if (sequence_desc & 0x80) {
+        if (buf_size <= 7)
+            return AVERROR_INVALIDDATA;
+        buf_size -= 7;
+
+        /* Get rle bitmap length including width and height fields (2x 16-bit) */
+        rle_bitmap_len = bytestream_get_be24(&buf);
+
+        if (rle_bitmap_len < 4) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "Invalid RLE data for object %d, no dimension\n",
+                   object->id);
+            return AVERROR_INVALIDDATA;
+        }
+
+        /* Get raw RLE bitmap length without width and length fields */
+        rle_bitmap_len -= 4;
+
+        if (buf_size > rle_bitmap_len) {
+            av_log(avctx, AV_LOG_ERROR,
+                   "Buffer dimension %d larger than the expected RLE data %d\n",
+                   buf_size, rle_bitmap_len);
+            return AVERROR_INVALIDDATA;
+        }
+
+        /* Get bitmap dimensions from data */
+        width  = bytestream_get_be16(&buf);
+        height = bytestream_get_be16(&buf);
+
+        /* Make sure the bitmap is not too large.
+         * Real decoders store all objects of an epoch in a single 4 MiB buffer.
+         * Only enforce the limit per object to tolerate non-compliant streams,
+         * which bounds decoded storage to 64 * 4 MiB */
+        if (MAX_OBJECT_WH < width || MAX_OBJECT_WH < height || !width || !height ||
+            width * height > PG_OBJ_BUFFER_SIZE) {
+            av_log(avctx, AV_LOG_ERROR, "Bitmap dimensions (%dx%d) invalid.\n", width, height);
+            return AVERROR_INVALIDDATA;
+        }
+
+        object->bitmap_size  = 0;
+        object->rle_data_len = 0;
+        /* Dimensions against video are checked at decode after cropping. */
+        object->w = width;
+        object->h = height;
+
+        av_fast_padded_malloc(&object->rle, &object->rle_buffer_size, buf_size);
+
+        if (!object->rle) {
+            object->rle_remaining_len = 0;
+            return AVERROR(ENOMEM);
+        }
+
+        memcpy(object->rle, buf, buf_size);
+        object->rle_remaining_len = rle_bitmap_len;
+    } else {
         /* Additional RLE data */
         if (buf_size > object->rle_remaining_len)
             return AVERROR_INVALIDDATA;
@@ -270,53 +336,11 @@ static int parse_object_segment(AVCodecContext *avctx,
         if (!rle)
             return AVERROR(ENOMEM);
         object->rle = rle;
-
         memcpy(object->rle + object->rle_data_len, buf, buf_size);

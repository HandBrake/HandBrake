__deps__ := FREETYPE

$(eval $(call import.MODULE.defs,HARFBUZZ,harfbuzz,$(__deps__)))
$(eval $(call import.CONTRIB.defs,HARFBUZZ))

HARFBUZZ.FETCH.url     = https://github.com/HandBrake/HandBrake-contribs/releases/download/contribs2/harfbuzz-15.0.0.tar.xz
HARFBUZZ.FETCH.url    += https://github.com/harfbuzz/harfbuzz/releases/download/15.0.0/harfbuzz-15.0.0.tar.xz
HARFBUZZ.FETCH.sha256  = 968536e9abd782f07f7954044c0c4020199fcdd39b41d221ec42d2a3be4a44df

HARFBUZZ.build_dir             = build/
HARFBUZZ.CONFIGURE.exe         = $(MESON.exe) setup
HARFBUZZ.prefix                = $(call fn.ABSOLUTE,$(HARFBUZZ.prefix/))contrib/
HARFBUZZ.CONFIGURE.deps        =
HARFBUZZ.CONFIGURE.shared      =
HARFBUZZ.CONFIGURE.host        =
HARFBUZZ.CONFIGURE.build       =
HARFBUZZ.CONFIGURE.static      = -Ddefault_library=static
HARFBUZZ.CONFIGURE.extra       = -Dlibdir=$(call fn.ABSOLUTE,$(HARFBUZZ.prefix/))contrib/lib/ \
                                 -Dutilities=disabled -Dbuildtype=release -Dfreetype=enabled \
                                 -Dtests=disabled -Ddocs=disabled -Dbenchmark=disabled -Dsubset=disabled \
                                 -Draster=disabled -Dvector=disabled -Dgpu=disabled -Dgpu_demo=disabled \
                                 -Dc_args="-I$(call fn.ABSOLUTE,$(CONTRIB.build/)include) $(call fn.ARGS,HARFBUZZ.GCC,*archs *sysroot *minver ?extra)" \
                                 -Dcpp_args="-I$(call fn.ABSOLUTE,$(CONTRIB.build/)include) $(call fn.ARGS,HARFBUZZ.GCC,*archs *sysroot *minver ?extra)" \
                                 -Dc_link_args="-L$(call fn.ABSOLUTE,$(CONTRIB.build/)lib) $(call fn.ARGS,HARFBUZZ.GCC,*archs *sysroot *minver ?extra.exe)" \
                                 -Dpkg_config_path=$(call fn.ABSOLUTE,$(CONTRIB.build/)lib/pkgconfig)

HARFBUZZ.CONFIGURE.env         =

ifeq (1,$(HOST.cross))
    ifeq (mingw,$(HOST.system))
        HARFBUZZ.CONFIGURE.extra += -Ddirectwrite=disabled \
                                    -Dglib=disabled \
                                    -Dgobject=disabled \
                                    -Dgraphite2=disabled \
                                    -Dicu=disabled \
                                    -Dgdi=disabled
    endif
endif

ifeq ($(HOST.system),darwin)
    HARFBUZZ.CONFIGURE.extra += -Dglib=disabled -Dcoretext=disabled
endif

ifeq (darwin,$(HOST.system))
    HARFBUZZ.CONFIGURE.extra += --cross-file=$(call fn.ABSOLUTE,$(SRC/))make/cross/$(HOST.machine)-darwin-gcc.meson
endif

ifeq (1-mingw,$(HOST.cross)-$(HOST.system))
    HARFBUZZ.CONFIGURE.extra += --cross-file=$(call fn.ABSOLUTE,$(SRC/))make/cross/$(HOST.machine)-w64-mingw32.meson
endif

HARFBUZZ.BUILD.make       = $(NINJA.exe)
HARFBUZZ.BUILD.extra      = -v
HARFBUZZ.INSTALL.make     = $(NINJA.exe)
HARFBUZZ.CLEAN.make       = $(NINJA.exe)
HARFBUZZ.UNINSTALL.make   = $(NINJA.exe)

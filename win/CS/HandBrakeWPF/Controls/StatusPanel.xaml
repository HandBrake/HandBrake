<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:themes="clr-namespace:HandBrakeWPF.Themes"
			 x:Class="HandBrakeWPF.Controls.StatusPanel">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="boolTovisibility" />
	</UserControl.Resources>

	<Grid>
		<Border Background="{DynamicResource Ui.BackgroundDark}"
				Opacity="{Binding Source={x:Static themes:ThemeLoader.ThemeOpacity}}"
				VerticalAlignment="Stretch"
				HorizontalAlignment="Stretch" />

		<Border VerticalAlignment="Center"
				HorizontalAlignment="Center"
				MinWidth="420"
				MaxWidth="560"
				Padding="20"
				CornerRadius="8"
				BorderBrush="{DynamicResource Ui.BackgroundDark}"
				Background="{DynamicResource Ui.Light}"
				BorderThickness="1">
			<Grid MinWidth="320">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0"
						   SnapsToDevicePixels="True"
						   VerticalAlignment="Top"
						   HorizontalAlignment="Left"
						   Style="{StaticResource pageHeader}"
						   Margin="0,0,0,6"
						   TextWrapping="Wrap"
						   Text="{Binding Message, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />

				<TextBlock Grid.Row="1"
						   SnapsToDevicePixels="True"
						   VerticalAlignment="Top"
						   HorizontalAlignment="Left"
						   Margin="0,0,0,14"
						   FontSize="15"
						   FontFamily="Segoe UI"
						   TextWrapping="Wrap"
						   Text="{Binding SubMessage, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />

				<ProgressBar Grid.Row="2"
							 x:Name="progressBar"
							 Height="12"
							 VerticalAlignment="Center"
							 AutomationProperties.Name="Scan progress"
							 Value="{Binding ProgressPercentage, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
							 IsIndeterminate="{Binding IsIndeterminate, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />

				<StackPanel Grid.Row="3"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Margin="0,14,0,0">
					<Button x:Name="SecondaryActionCtl"
							Content="{Binding SecondaryActionText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
							Click="PerformSecondaryAction"
							Margin="0,0,8,0"
							Padding="12,4"
							AutomationProperties.Name="Secondary action"
							Visibility="{Binding IsActionButton2Visible, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource boolTovisibility}}" />

					<Button x:Name="StatusActionButton"
							Content="{Binding ActionText, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
							Click="StatusActionButton_OnClick"
							Padding="14,4"
							IsCancel="True"
							AutomationProperties.Name="Primary action"
							Visibility="{Binding IsActionButtonVisible, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}, Converter={StaticResource boolTovisibility}}" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>

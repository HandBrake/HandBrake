<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Modern theme built on top of the WPF Fluent theme (PresentationFramework.Fluent).
        Ui.Background / Ui.BackgroundLight / Ui.BackgroundDark are intentionally left to be
        set at runtime by ThemeLoader.ApplyModernBackgroundColors(), since they must track
        the current Windows light/dark setting and update live when it changes.
    -->

    <SolidColorBrush x:Key="Ui.Light" Color="#464646" />
    <SolidColorBrush x:Key="Ui.Light2" Color="#464646" />
    <SolidColorBrush x:Key="Ui.ToolbarHover" Color="#acacac" />
    <SolidColorBrush x:Key="Ui.ContrastLight" Color="#C0C0C0" />
    <SolidColorBrush x:Key="Ui.Ultralight" Color="#606060" />
    <SolidColorBrush x:Key="Ui.UltraLight2" Color="#acacac" />
    <SolidColorBrush x:Key="Ui.UltraLight3" Color="#E3E3E3" />
    <SolidColorBrush x:Key="Ui.ListBoxSelect" Color="#606060" />
    <SolidColorBrush x:Key="Ui.Arrow" Color="#252525" />

    <SolidColorBrush x:Key="Ui.Blue" Color="#00579f" />
    <SolidColorBrush x:Key="Ui.BlueBright" Color="#006cc5" />


    <Style TargetType="{x:Type StatusBar}" BasedOn="{StaticResource {x:Type StatusBar}}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="2,0" />
    </Style>

    <Style TargetType="{x:Type StatusBarItem}">
        <Setter Property="Padding" Value="2,0" />
    </Style>

</ResourceDictionary>

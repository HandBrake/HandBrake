<Window x:Class="HandBrakeWPF.Views.StaticPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:HandBrakeWPF.Converters"
             xmlns:Properties="clr-namespace:HandBrakeWPF.Properties"
             xmlns:standalone="clr-namespace:HandBrakeWPF.Views.Standalone"
             mc:Ignorable="d" SizeToContent="WidthAndHeight"
             TextOptions.TextFormattingMode="Display"
             WindowStartupLocation="CenterScreen"
             Title="{Binding Title}"
             MinHeight="550">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu AutomationProperties.Name="Preview Context Menu">
            <MenuItem Header="{x:Static Properties:Resources.StaticPreviewView_ShowPictureSettingsAdjustment}" Command="{Binding RelayCommand}" CommandParameter="ShowCropPanel" />
        </ContextMenu>
    </Window.ContextMenu>
    
    <Grid>

        <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource Ui.Background}"
                Visibility="{Binding PreviewNotAvailable, Converter={StaticResource booleanToVisibilityConverter}}">
            <TextBlock Text="No Preview Available" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="60"
                       Style="{StaticResource pageHeader}" Opacity="0.75" />
        </Border>

        <!-- Preview Area -->
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Image x:Name="previewImage" Panel.ZIndex="0" Source="{Binding PreviewImage}" MaxWidth="{Binding Width}" MaxHeight="{Binding Height}" 
                   MouseWheel="PreviewImage_OnMouseWheel"  />
            <!--Visibility="{Binding IsMediaPlayerVisible, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}"-->

            <MediaElement x:Name="videoPlayer" Panel.ZIndex="1" Source="{Binding MediaPlayerSource}" ScrubbingEnabled="True" LoadedBehavior="Manual"
                          MaxWidth="{Binding Width}" MaxHeight="{Binding Height}" Visibility="{Binding IsMediaPlayerVisible, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=false}" />
        </Grid>
 

        <Canvas x:Name="dragCanvas" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" IsHitTestVisible="True"
                SizeChanged="DragCanvas_OnSizeChanged">
            <Border x:Name="cropSettingsBorder" BorderBrush="{DynamicResource Ui.ContrastLight}" BorderThickness="1" CornerRadius="10"
                    Padding="8" MinWidth="220" Background="{DynamicResource Ui.Dark}" Opacity="0.95"
                    Visibility="{Binding ShowPictureSettingControls, Converter={StaticResource booleanToVisibilityConverter}}"
                    MouseLeftButtonDown="CropSettingsBorder_OnMouseLeftButtonDown"
                    MouseLeftButtonUp="CropSettingsBorder_OnMouseLeftButtonUp"
                    MouseMove="CropSettingsBorder_OnMouseMove"
                    Loaded="CropSettingsBorder_OnLoaded"
                    SizeChanged="CropSettingsBorder_OnSizeChanged">

                <standalone:CropPanelView DataContext="{Binding PictureSettingsViewModel}" />
            </Border>
        </Canvas>

        <Border BorderBrush="{DynamicResource Ui.ContrastLight}" BorderThickness="1" CornerRadius="12" Padding="12"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" MinWidth="560" MaxWidth="920"
                Background="{DynamicResource Ui.Dark}" Opacity="0.94">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8" Visibility="{Binding IsEncoding, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static Properties:Resources.StaticPreview_Previews}" Margin="0,0,12,0" Style="{StaticResource sectionHeader}" />
                    <Slider Maximum="{Binding TotalPreviews}" Minimum="0"
                            AutomationProperties.Name="{x:Static Properties:Resources.StaticPreviewView_SelectPreviewImage}"
                            Value="{Binding SelectedPreviewImage}" Grid.Column="1"
                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                            Background="Transparent" TickPlacement="TopLeft" />
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,0,0,8"
                           Visibility="{Binding IsEncoding, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}">
                    <CheckBox IsChecked="{Binding ShowPictureSettingControls}" Margin="0,0,20,0"
                              Visibility="{Binding IsMediaPlayerVisible, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}">
                        <TextBlock Text="{x:Static Properties:Resources.StaticPreviewView_ShowPictureSettingsAdjustment}" />
                    </CheckBox>

                    <CheckBox IsChecked="{Binding ShowCropBoundaries}">
                        <TextBlock Text="{x:Static Properties:Resources.StaticPreviewView_ShowCropBoundaries}" />
                    </CheckBox>
                </WrapPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{x:Static Properties:Resources.StaticPreviewView_LivePreview}"
                            Command="{Binding RelayCommand}" CommandParameter="EncodeFile"
                            Visibility="{Binding IsEncoding, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}" />

                    <Button Grid.Column="1" Padding="8,2" Click="PlayVideo_OnClick" Margin="6,0,0,0"
                            Visibility="{Binding IsMediaPlayerVisible, Converter={StaticResource booleanToVisibilityConverter}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlaying, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}">
                                <Image Source="Images/Play_small.png" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static Properties:Resources.StaticPreviewView_Play}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsPlaying, Converter={StaticResource booleanToVisibilityConverter}}">
                                <Image Source="Images/stop.png" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static Properties:Resources.MainView_Stop}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Grid.Column="2" Margin="6,0,0,0" Command="{Binding RelayCommand}" CommandParameter="ClosePlayer"
                            Visibility="{Binding IsMediaPlayerVisible, Converter={StaticResource booleanToVisibilityConverter}}">
                        <TextBlock Text="{x:Static Properties:Resources.StaticPreviewView_ClosePlayer}" VerticalAlignment="Center" />
                    </Button>

                    <TextBlock Grid.Column="3" Margin="16,0,6,0" Text="{x:Static Properties:Resources.StaticPreviewView_Duration}"
                               Visibility="{Binding IsEncoding, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}" />
                    <ComboBox Grid.Column="4" Width="70" ItemsSource="{Binding AvailableDurations}" SelectedItem="{Binding Duration}"
                              Visibility="{Binding IsEncoding, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}" />

                    <CheckBox Grid.Column="5" Margin="14,0,0,0" IsChecked="{Binding UseExternalPlayer}" VerticalAlignment="Center"
                              Visibility="{Binding IsEncoding, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}">
                        <TextBlock Text="{x:Static Properties:Resources.StaticPreviewView_UseExternalPlayer}" />
                    </CheckBox>

                    <Button Grid.Column="6" Margin="12,0,0,0" IsCancel="True"
                            Visibility="{Binding IsEncoding, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=true}"
                            Command="{Binding RelayCommand}" CommandParameter="CloseWindow"
                            Content="{x:Static Properties:Resources.Generic_Close}" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,8,0,0"
                      Visibility="{Binding IsMediaPlayerVisible, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=false}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,8,0" Text="{x:Static Properties:Resources.StaticPreview_Volume}" />
                    <Slider Grid.Column="1" Name="volumeSlider" VerticalAlignment="Center" ValueChanged="ChangeMediaVolume"
                            Minimum="0" Maximum="1" Value="0.5" Width="180" Background="Transparent" TickPlacement="None" />
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" Text="{Binding ElementName=volumeSlider, Path=Value, StringFormat={}{0:0%}}" />
                </Grid>

                <Grid Grid.Row="4" Margin="0,10,0,0" Visibility="{Binding IsEncoding, Converter={StaticResource booleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static Properties:Resources.StaticPreview_EncodingPreview}" Margin="0,0,0,8" Style="{StaticResource sectionHeader}" />

                    <ProgressBar Grid.Row="1" Grid.Column="0" MinHeight="20" Maximum="100" Minimum="0"
                                 Value="{Binding PercentageValue}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" Text="{Binding Percentage}" HorizontalAlignment="Right" />
                    <Button Grid.Row="1" Grid.Column="2" MinHeight="20" Margin="10,0,0,0"
                            Content="{x:Static Properties:Resources.StaticPreviewView_CancelPreview}" Command="{Binding RelayCommand}" CommandParameter="CancelEncode"
                            Visibility="{Binding IsEncoding, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=false}" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>

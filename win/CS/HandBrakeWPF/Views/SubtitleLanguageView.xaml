<Window x:Class="HandBrakeWPF.Views.SubtitleLanguageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Properties="clr-namespace:HandBrakeWPF.Properties"
        Title="{x:Static Properties:Resources.SubtitleViewModel_ImportLanguage}"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Text="{x:Static Properties:Resources.SubtitleViewModel_ImportLanguage}" />
        <ComboBox Grid.Row="1"
                  MinWidth="250"
                  ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  DisplayMemberPath="DisplayNative" />
        <StackPanel Grid.Row="2"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Padding="10,3"
                    Content="{x:Static Properties:Resources.Generic_Cancel}"
                    Command="{Binding RelayCommand}"
                    CommandParameter="Cancel"
                    IsCancel="True" />
            <Button Padding="10,3"
                    Content="{x:Static Properties:Resources.Generic_Add}"
                    Command="{Binding RelayCommand}"
                    CommandParameter="Confirm"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>

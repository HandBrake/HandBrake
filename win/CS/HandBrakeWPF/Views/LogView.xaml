<Window x:Class="HandBrakeWPF.Views.LogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Properties="clr-namespace:HandBrakeWPF.Properties"
        xmlns:converters="clr-namespace:HandBrakeWPF.Converters"
        Title="{Binding Title}"
        Width="740"
        Height="650"
        MinWidth="725"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="LogView_OnPreviewKeyDown">

    <Window.Resources>
        <converters:ThemeImageConverter x:Key="themeConverter" />
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,5,5,5">
                <StackPanel Orientation="Horizontal" >
                    <TextBlock Text="{x:Static Properties:Resources.LogView_ChooseLogFile}" Margin="5,0,5,0" Style="{StaticResource subHeader}" />
                    <ComboBox ItemsSource="{Binding LogFiles}" SelectedItem="{Binding SelectedLogFile}" DisplayMemberPath="FileDisplayName" Width="250" MaxWidth="300" />
                </StackPanel>

                <Grid Width="160" MaxHeight="24" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="searchBox" Padding="0,0,20,0" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchBox_TextChanged" Height="22" 
                             AutomationProperties.Name="Search" />

                    <TextBlock Text="search ..." Margin="5,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource Ui.ContrastLight}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.IsEmpty, ElementName=searchBox}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Click="ClearSearch_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,3,5,3" BorderThickness="0" Background="Transparent"
                            Cursor="Hand" AutomationProperties.Name="Clear search">
                        <Path Width="8" Height="8" Stretch="Uniform" Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{DynamicResource ButtonGlyphBrush}" StrokeThickness="1.5" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.IsEmpty, ElementName=searchBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Button Command="{Binding RelayCommand}" CommandParameter="CopyLog" Margin="10,0,0,0"
                        AutomationProperties.Name="{x:Static Properties:Resources.LogView_CopyClipboard}" >
                    <StackPanel Orientation="Horizontal">
                        <Image Width="16" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='../Views/Images/Copy.png'}" />
                        <TextBlock Margin="2,0,0,0" Text="{x:Static Properties:Resources.LogView_CopyClipboard}" />
                    </StackPanel>
                </Button>

                <Button x:Name="logViewOptions" Margin="5,0,0,0" Click="logViewOptions_OnClick" >
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='Advanced.png'}" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center"
                            Text="{x:Static Properties:Resources.QueueView_Options}" Margin="5,0,0,0" />
                            <Path Height="5" Margin="2,2,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Data="M 0 0 L 4 4 L 8 0 Z"
                       Fill="{DynamicResource ButtonGlyphBrush}" x:Name="dropdownArrowPreset" />
                        </StackPanel>
                    </Button.Content>

                    <Button.ContextMenu>
                        <ContextMenu x:Name="MainContextMenu" PlacementRectangle="{Binding RelativeSource={RelativeSource Self}}">
                            <MenuItem Command="{Binding RelayCommand}" CommandParameter="ClearCompleted" Header="{x:Static Properties:Resources.LogView_ClearCompletedLogs}" />
                            <Separator />

                            <MenuItem Command="{Binding RelayCommand}" CommandParameter="OpenLogDirectory" Header="{x:Static Properties:Resources.LogView_OpenLogDir}" >
                                <MenuItem.Icon>
                                    <Image Width="16" Height="16"
                                           Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='../Views/Images/Folder.png'}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <StackPanel Orientation="Horizontal" Margin="15,0,0,0" IsHitTestVisible="False">
                                <TextBlock Text="{x:Static Properties:Resources.LogView_LogFiles}"/>
                                <TextBlock Text="{Binding LogFileCount}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="15,0,0,0" IsHitTestVisible="False">
                                <TextBlock Text="{x:Static Properties:Resources.LogView_LogDirectorySize}"/>
                                <TextBlock Text="{Binding LogFileSizeTotal}"  />
                                <TextBlock Text=" MB" />
                            </StackPanel>
  
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

            </StackPanel>
      
            <TextBox Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Visible" TextWrapping="Wrap" x:Name="logText" VerticalContentAlignment="Top" IsReadOnly="True">

                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static Properties:Resources.LogView_CopyClipboard}" Command="{Binding RelayCommand}" CommandParameter="CopyLog" >
                            <MenuItem.Icon>
                                <Image Width="16" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='../Views/Images/Copy.png'}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static Properties:Resources.LogView_OpenLogDir}" Command="{Binding RelayCommand}" CommandParameter="OpenLogDirectory">
                            <MenuItem.Icon>
                                <Image Width="16" Source="{Binding Converter={StaticResource themeConverter}, ConverterParameter='../Views/Images/Folder.png'}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{x:Static Properties:Resources.LogView_AutoScrolling}" IsCheckable="True" IsChecked="True" x:Name="AutoScroll" />
                        
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>

        </Grid>

    </Grid>
</Window>

    
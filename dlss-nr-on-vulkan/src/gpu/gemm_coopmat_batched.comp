#version 450
/*
 * gemm_coopmat_batched — C[b] = A[b] * B[b] on Xe2 XMX, for a batch of matrices.
 *
 * Same cooperative-matrix configuration as gemm_coopmat.comp (FP16 operands, FP32
 * accumulator, the single M=8 N=16 K=16 float shape Mesa exposes); the batch index
 * is the z dimension of the dispatch and each operand carries its own element
 * stride, so the three tensors need not be packed the same way.
 *
 * `bt != 0` means B is stored as (N, K) row-major — the layout a transposed key
 * matrix already has. Loading it column-major reads it as the K x N operand the
 * multiply wants, so attention needs no transpose copy.
 */
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer Abuf { float16_t A[]; };
layout(binding = 1) readonly  buffer Bbuf { float16_t B[]; };
layout(binding = 2) writeonly buffer Cbuf { float     C[]; };

layout(push_constant) uniform Push { uint M, N, K, sa, sb, sc, bt; } pc;

const uint TM = 8, TN = 16, TK = 16;

void main() {
    uint row = gl_WorkGroupID.y * TM;
    uint col = gl_WorkGroupID.x * TN;
    if (row >= pc.M || col >= pc.N) return;
    uint batch = gl_WorkGroupID.z;
    uint ao = batch * pc.sa, bo = batch * pc.sb, co = batch * pc.sc;

    coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc =
        coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0.0);

    coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a;
    coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> b;
    if (pc.bt != 0) {
        for (uint k = 0; k < pc.K; k += TK) {
            coopMatLoad(a, A, ao + row * pc.K + k, pc.K, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(b, B, bo + col * pc.K + k, pc.K, gl_CooperativeMatrixLayoutColumnMajor);
            acc = coopMatMulAdd(a, b, acc);
        }
    } else {
        for (uint k = 0; k < pc.K; k += TK) {
            coopMatLoad(a, A, ao + row * pc.K + k, pc.K, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(b, B, bo + k * pc.N + col, pc.N, gl_CooperativeMatrixLayoutRowMajor);
            acc = coopMatMulAdd(a, b, acc);
        }
    }
    coopMatStore(acc, C, co + row * pc.N + col, pc.N, gl_CooperativeMatrixLayoutRowMajor);
}

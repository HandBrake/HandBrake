+/* Experiment: Xe2's large GRF mode for compute — 256 physical registers a thread and half
+ * the threads an EU. Read once; anv sets STATE_COMPUTE_MODE's LargeGRFMode to match. */
+static inline bool
+brw_xe2_large_grf(void)
+{
+   static int cached = -1;
+   if (cached < 0) {
+      const char *value = getenv("INTEL_XE2_LARGE_GRF");
+      cached = value != NULL && value[0] == '1';
+   }
+   return cached == 1;
+}

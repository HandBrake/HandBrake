#version 450
/* Minimal reproducer: touching a cooperative matrix before storing it scrambles the
 * store. Set TOUCH to choose what is done to the accumulator between `coopMatMulAdd`
 * and `coopMatStore`; TOUCH=0 is the control and is correct.
 *
 *   0  store the accumulator untouched            correct
 *   1  acc = acc * 2.0        (whole matrix)      wrong
 *   2  acc[0] = acc[0] * 2.0  (one element)       wrong
 *   3  copy to a fresh matrix, store that         wrong
 *   4  store a float16 matrix into a float[]         wrong — but is the *shader*
 *                                                  valid? the component type does
 *                                                  not match the destination's
 *   5  store a float16 matrix into a float16_t[]   the type-correct version
 */
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#ifndef TOUCH
#define TOUCH 0
#endif

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) readonly buffer A { float16_t a[]; };
layout(set = 0, binding = 1) readonly buffer B { float16_t b[]; };
layout(set = 0, binding = 2) writeonly buffer C { float c[]; };
layout(set = 0, binding = 2) writeonly buffer Ch { float16_t ch[]; };
layout(push_constant) uniform Push { uint M, N, K; } pc;

const uint M = 8, N = 16;

void main() {
    uint K = pc.K;
    coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> acc =
        coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(0.0);
    coopmat<float16_t, gl_ScopeSubgroup, M, 16, gl_MatrixUseA> ma;
    coopmat<float16_t, gl_ScopeSubgroup, 16, N, gl_MatrixUseB> mb;
    for (uint k = 0; k < K; k += 16) {
        coopMatLoad(ma, a, k, K, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb, b, k * N, N, gl_CooperativeMatrixLayoutRowMajor);
        acc = coopMatMulAdd(ma, mb, acc);
    }
#if TOUCH == 1
    acc = acc * 2.0;
#elif TOUCH == 2
    acc[0] = acc[0] * 2.0;
#elif TOUCH == 3
    coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> copy = acc;
    acc = copy;
#elif TOUCH == 5
    coopmat<float16_t, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> narrow =
        coopmat<float16_t, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(acc);
    coopMatStore(narrow, ch, 0, N, gl_CooperativeMatrixLayoutRowMajor);
    return;
#elif TOUCH == 4
    coopmat<float16_t, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> narrow =
        coopmat<float16_t, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(acc);
    coopMatStore(narrow, c, 0, N, gl_CooperativeMatrixLayoutRowMajor);
    return;
#endif
    coopMatStore(acc, c, 0, N, gl_CooperativeMatrixLayoutRowMajor);
}
